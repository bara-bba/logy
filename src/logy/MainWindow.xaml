<Window x:Class="Logy.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="logy" Width="960" Height="600" MinWidth="420" MinHeight="300"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource Brush.App}" Foreground="{StaticResource Brush.TextPrimary}"
        FontFamily="Segoe UI" FontSize="12" Icon="app.ico">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="34" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="34" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar (6.1). -->
        <Grid Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                <Image Source="app.ico" Width="16" Height="16" />
                <TextBlock Text="logy" Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                <ToggleButton x:Name="PinButton" Style="{StaticResource CaptionToggle}" Content="&#xE718;" ToolTip="Always on top"
                              Checked="Pin_Changed" Unchecked="Pin_Changed" />
                <Button Style="{StaticResource CaptionButton}" Content="&#xE713;" ToolTip="Settings" Click="Settings_Click" />
                <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" ToolTip="Minimize" Click="Minimize_Click" />
                <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" ToolTip="Maximize" Click="Maximize_Click" />
                <Button Style="{StaticResource CaptionCloseButton}" Content="&#xE8BB;" ToolTip="Close" Click="Close_Click" />
            </StackPanel>
        </Grid>

        <!-- Body: panels as columns, then the + strip. -->
        <Grid Grid.Row="1" Margin="6,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="34" />
            </Grid.ColumnDefinitions>
            <ScrollViewer x:Name="PanelScroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel x:Name="PanelHost" Orientation="Horizontal" />
            </ScrollViewer>
            <TextBlock x:Name="EmptyHint" Text="Press + to add a repo" Foreground="{StaticResource Brush.TextTertiary}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />

            <Border Grid.Column="1" Background="{StaticResource Brush.Card}" CornerRadius="6" Margin="4,0,4,0">
                <Button x:Name="AddButton" Style="{StaticResource AccentIconButton}" Content="&#xE710;" ToolTip="Add repo"
                        VerticalAlignment="Top" Margin="0,4,0,0" Click="Add_Click" />
            </Border>

            <Popup x:Name="Picker" PlacementTarget="{Binding ElementName=AddButton}" Placement="Left" StaysOpen="False"
                   AllowsTransparency="True" Opened="Picker_Opened" HorizontalOffset="-6">
                <Border Width="280" Height="400" Background="{StaticResource Brush.Card}" CornerRadius="6" Padding="6">
                    <DockPanel>
                        <TextBox x:Name="PickerFilter" DockPanel.Dock="Top" Margin="0,0,0,6" TextChanged="PickerFilter_TextChanged"
                                 PreviewKeyDown="PickerFilter_PreviewKeyDown" />
                        <TextBlock x:Name="PickerEmpty" DockPanel.Dock="Top" Foreground="{StaticResource Brush.TextTertiary}"
                                   Margin="4" TextWrapping="Wrap" Visibility="Collapsed" />
                        <ListBox x:Name="PickerList" Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 PreviewMouseLeftButtonUp="PickerList_Click" KeyDown="PickerList_KeyDown">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource PickerItem}">
                                    <Setter Property="IsEnabled" Value="{Binding CanOpen}" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" />
                                        <Border Style="{StaticResource Chip}" Margin="6,0,0,0" Visibility="{Binding ChipVisibility}">
                                            <TextBlock Text="{Binding Chip}" FontSize="9" />
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Popup>
        </Grid>
    </Grid>
</Window>
