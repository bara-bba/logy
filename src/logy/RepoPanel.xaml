<UserControl x:Class="Logy.RepoPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Logy"
             x:Name="Self" MinWidth="220">
    <UserControl.Resources>
        <Style x:Key="Badge" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="5,0,0,0" />
        </Style>

        <Style x:Key="CommitItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="ToolTip" Value="{Binding Tooltip}" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="600" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Brush.Row.Hover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Brush.Button}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsFooter}" Value="True">
                    <Setter Property="IsHitTestVisible" Value="False" />
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="ToolTip" Value="{x:Null}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Border Background="{StaticResource Brush.Card}" CornerRadius="6" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header. Wide: title left, buttons right on one 36 px row. Narrow (title and
                     buttons do not fit side by side): title on its own row, buttons below. -->
                <Border Background="{StaticResource Brush.Header}" CornerRadius="6,6,0,0">
                    <Grid x:Name="HeaderGrid" Margin="8,0,5,0" SizeChanged="HeaderGrid_SizeChanged">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="36" />
                            <RowDefinition x:Name="HeaderRow2" Height="0" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <DockPanel x:Name="HeaderButtons" Grid.Column="1" VerticalAlignment="Center" LastChildFill="False">
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" ToolTip="Close panel" Margin="2,0,0,0" Click="Close_Click" />
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                            <ToggleButton x:Name="PullsToggle" Style="{StaticResource PanelToggle}" Margin="2,0" ToolTip="Open pull requests"
                                          Checked="PullsToggle_Changed" Unchecked="PullsToggle_Changed">
                                <TextBlock x:Name="PullsToggleText" Text="PR" />
                            </ToggleButton>
                            <Button x:Name="FetchButton" Style="{StaticResource IconButton}" Content="&#xE895;" ToolTip="Fetch" Margin="2,0" Click="Fetch_Click" />
                            <Button x:Name="PullButton" Style="{StaticResource IconButton}" Content="&#xE896;" ToolTip="Pull (fast-forward only)" Margin="2,0" Click="Pull_Click" />
                            <Button x:Name="PushButton" Style="{StaticResource AccentIconButton}" Content="&#xE898;" ToolTip="Push" Margin="2,0" Click="Push_Click"
                                    ToolTipService.ShowOnDisabled="True" />
                            </StackPanel>
                        </DockPanel>
                        <StackPanel x:Name="HeaderTitle" Orientation="Horizontal" VerticalAlignment="Center" ClipToBounds="True">
                            <TextBlock x:Name="NameText" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
                            <Border x:Name="ChipBorder" Style="{StaticResource Chip}" Margin="6,0,0,0">
                                <TextBlock x:Name="ChipText" FontSize="9" Foreground="{StaticResource Brush.TextPrimary}" />
                            </Border>
                            <TextBlock x:Name="BranchText" Style="{StaticResource Badge}" Margin="6,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="110" />
                            <TextBlock x:Name="AheadText" Style="{StaticResource Badge}" />
                            <TextBlock x:Name="BehindText" Style="{StaticResource Badge}" />
                            <TextBlock x:Name="DirtyText" Style="{StaticResource Badge}" ToolTip="changed entries" />
                            <TextBlock x:Name="GoneText" Style="{StaticResource Badge}" Text="gone" Foreground="{StaticResource Brush.TextTertiary}"
                                       ToolTip="the upstream branch was deleted on the remote" />
                            <TextBlock x:Name="DivergedText" Style="{StaticResource Badge}" Text="diverged" Foreground="{StaticResource Brush.Danger}"
                                       ToolTip="branches diverged: rebase or merge in a terminal" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Error bar. -->
                <Border x:Name="ErrorBar" Grid.Row="1" Background="{StaticResource Brush.Danger}" Visibility="Collapsed" MinHeight="22">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource CaptionButton}" Width="22" Height="22" FontSize="9"
                                Content="&#xE711;" Click="DismissError_Click" ToolTip="Dismiss" />
                        <TextBlock x:Name="ErrorText" Foreground="#FFFFFFFF" Margin="8,3" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonUp="ErrorText_Click" />
                    </DockPanel>
                </Border>

                <!-- Commit list. -->
                <ListBox x:Name="CommitList" Grid.Row="2" Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource CommitItem}"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionMode="Single" SelectionChanged="CommitList_SelectionChanged"
                         PreviewMouseLeftButtonDown="CommitList_PreviewMouseLeftButtonDown" KeyDown="CommitList_KeyDown">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:CommitRowViewModel}">
                            <Grid Height="22">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <local:GraphCell Row="{Binding Row}"
                                                 Width="{Binding GraphWidth, ElementName=Self}"
                                                 GraphStyle="{Binding GraphStyle, ElementName=Self}"
                                                 Clipped="{Binding GraphClipped, ElementName=Self}" />
                                <TextBlock Grid.Column="1" Text="{Binding ShortHash}" FontFamily="{StaticResource Font.Mono}" FontSize="10"
                                           Foreground="{StaticResource Brush.TextTertiary}" VerticalAlignment="Center" Margin="2,0,6,0" />
                                <ItemsControl Grid.Column="2" ItemsSource="{Binding Pills}" VerticalAlignment="Center" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type local:Pill}">
                                            <Border Background="{Binding Background}" CornerRadius="3" Padding="5,0" Margin="0,0,4,0" MaxWidth="120">
                                                <TextBlock Text="{Binding Text}" Foreground="{Binding Foreground}" FontSize="9" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Grid.Column="3" Text="{Binding Subject}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="11">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFooter}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource Brush.TextTertiary}" />
                                                    <Setter Property="Margin" Value="8,0,0,0" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Grid.Column="4" Text="{Binding Date}" FontSize="10" Foreground="{StaticResource Brush.TextTertiary}"
                                           VerticalAlignment="Center" Margin="6,0,8,0" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock x:Name="ListMessage" Grid.Row="2" Foreground="{StaticResource Brush.TextTertiary}" Margin="12"
                           TextWrapping="Wrap" Visibility="Collapsed" />

                <!-- Pull request view (replaces the commit list while PR is on). -->
                <DockPanel x:Name="PullView" Grid.Row="2" Visibility="Collapsed">
                    <DockPanel DockPanel.Dock="Top" Margin="8,6,8,4">
                        <Button x:Name="NewPullButton" DockPanel.Dock="Left" Style="{StaticResource AccentTextButton}" Height="24"
                                Content="New pull request" Click="NewPull_Click" />
                        <TextBlock x:Name="PullStatus" Foreground="{StaticResource Brush.TextTertiary}" FontSize="10"
                                   VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <TextBlock x:Name="PullMessage" DockPanel.Dock="Top" Foreground="{StaticResource Brush.TextTertiary}" Margin="12,6"
                               TextWrapping="Wrap" Visibility="Collapsed" />
                <ListBox x:Name="PullList" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionMode="Single"
                         SelectionChanged="PullList_SelectionChanged" KeyDown="PullList_KeyDown">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource CommitItem}">
                            <Setter Property="Height" Value="42" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="ToolTip" Value="{Binding Tooltip}" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:PullRowViewModel}">
                            <StackPanel Margin="10,4,8,4">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Age}" FontSize="10" Foreground="{StaticResource Brush.TextTertiary}" Margin="6,0,0,0" />
                                    <TextBlock FontSize="11" TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding Number, Mode=OneWay}" Foreground="{StaticResource Brush.TextTertiary}" />
                                        <Run Text="{Binding Title, Mode=OneWay}" />
                                    </TextBlock>
                                </DockPanel>
                                <TextBlock Text="{Binding Line2}" FontSize="10" Foreground="{StaticResource Brush.TextSecondary}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                </DockPanel>

                <!-- Selected pull request: description and actions. -->
                <Border x:Name="PullPane" Grid.Row="3" Height="170" Background="{StaticResource Brush.Card}" Visibility="Collapsed">
                    <Grid>
                        <Rectangle Height="1" Fill="{StaticResource Brush.Header}" VerticalAlignment="Top" />
                        <DockPanel Margin="10,8,10,8">
                            <WrapPanel x:Name="PullActions" DockPanel.Dock="Bottom" Margin="0,6,0,0">
                                <Button x:Name="ApproveButton" Style="{StaticResource TextButton}" Height="24" Content="Approve"
                                        Margin="0,0,6,4" Click="Approve_Click" />
                                <StackPanel x:Name="MergeButtons" Orientation="Horizontal" />
                                <Button Style="{StaticResource TextButton}" Height="24" Content="Open" Margin="0,0,0,4"
                                        Click="OpenPull_Click" ToolTip="Open in the browser" />
                            </WrapPanel>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <TextBlock x:Name="PullTitle" FontWeight="SemiBold" FontSize="11" TextWrapping="Wrap" />
                                    <TextBlock x:Name="PullLine2" FontSize="10" Foreground="{StaticResource Brush.TextSecondary}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                    <TextBlock x:Name="PullDescription" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" />
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </Grid>
                </Border>
                <Border x:Name="DetailsPane" Grid.Row="3" Height="160" Background="{StaticResource Brush.Card}" Visibility="Collapsed">
                    <Grid>
                        <Rectangle Height="1" Fill="{StaticResource Brush.Header}" VerticalAlignment="Top" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,1,0,0">
                            <StackPanel Margin="10,8">
                                <TextBlock x:Name="DetailsMessage" TextWrapping="Wrap" FontSize="11" />
                                <TextBlock x:Name="DetailsFiles" TextWrapping="Wrap" FontFamily="{StaticResource Font.Mono}" FontSize="10"
                                           Foreground="{StaticResource Brush.TextSecondary}" Margin="0,8,0,0" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Border>

    </Grid>
</UserControl>
