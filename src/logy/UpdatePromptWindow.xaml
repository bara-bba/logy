<Window x:Class="Logy.UpdatePromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="logy update" Width="360" Height="140" ResizeMode="NoResize"
        WindowStyle="None" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource Brush.Card}" Foreground="{StaticResource Brush.TextPrimary}"
        FontFamily="Segoe UI" FontSize="12">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="140" ResizeBorderThickness="0" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="MessageText" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center" />
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
            <Button Style="{StaticResource TextButton}" Content="Later" Margin="0,0,8,0" Click="Later_Click" />
            <Button Style="{StaticResource AccentTextButton}" Content="Update" Click="Update_Click" />
        </StackPanel>
    </Grid>
</Window>
