<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Multi-size icon generated by tools/make_icon.py (white variant). -->
    <ApplicationIcon>app.ico</ApplicationIcon>
    <AssemblyName>logy</AssemblyName>
    <RootNamespace>Logy</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Version>0.2.0</Version>
    <!-- Velopack must run before any window, so Program.cs supplies Main instead of App.xaml. -->
    <StartupObject>Logy.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\logy.core\logy.core.csproj" />
  </ItemGroup>

</Project>
